# Copy to .env.local (git-ignored) and fill in. Never commit real credentials.
# Next.js loads .env and .env.local on the server only; none of these reach the browser.

# Storefront catalogue source: mock (seeded web DB) or erp (RetailERP). Admin → Products always reads RetailERP.
DATA_SOURCE=mock

# Website-owned, writable database: admin users, orders, carts, CMS, productWebMeta.
# Use a separate website database; do not write into the RetailERP database (grooretailerp1).
MONGODB_URI=
WEB_DB_NAME=woven_essence_web

# RetailERP database (read-only). Admin → Products reads grooretailerp1.barcodeLabel from here.
# ERP_MONGO_URI is accepted as an alias (the name the RetailERP backend's .env uses).
# Falls back to MONGODB_URI when neither is set.
ERP_MONGODB_URI=
ERP_DB_NAME=grooretailerp1

# Deployed RetailERP web app; serves relative ERP image paths such as /august_8A_images/4A1142.jpg.
ERP_IMAGE_BASE=https://wovenessence.etpl.ai
# DigitalOcean Spaces bucket host(s) holding ERP product photos (comma-separated, exact hosts).
ERP_IMAGE_SPACES_HOSTS=templeimg.blr1.digitaloceanspaces.com

# Optional DigitalOcean Spaces keys (a read-only key is enough). With them, private ERP product
# photos are served through short-lived presigned URLs; without them only public-read photos show.
DO_SPACES_KEY=
DO_SPACES_SECRET=

# NVIDIA API key (nvapi-…) for Admin → AI Assistant; create one at https://build.nvidia.com. Server-only.
# Without it the assistant page loads but cannot answer.
NVIDIA_API_KEY=
# Optional. The model must support tool calling. Default: nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL=
# Optional. Default: https://integrate.api.nvidia.com/v1
NVIDIA_BASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API (server-only; never expose these with NEXT_PUBLIC_*)
# Leave WHATSAPP_ENABLED=false until the access token, phone number id and all
# approved templates are in place. Checkout and email/password login keep working.
# Docs: docs/whatsapp-integration.md
# ---------------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Current stable Graph API version (Meta changelog, July 2026). Override only deliberately.
WHATSAPP_API_VERSION=v26.0
# Webhook verification token: choose a long random value and enter the SAME value in
# Meta App Dashboard → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard → App settings → Basic → App secret (used for X-Hub-Signature-256).
WHATSAPP_APP_SECRET=

# Language/locale of the approved templates. Must match WhatsApp Manager exactly (en, en_US, ...).
# The approved wovenessence_otp template uses "en_US".
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Approved template names. The authentication template needs the code in the body and,
# for a copy-code template, the URL button (set WHATSAPP_OTP_INCLUDE_BUTTON=false only
# for a button-less/zero-tap template).
# OTP login is WhatsApp-only; the old SMS path is disabled because no SMS provider is implemented.
WHATSAPP_OTP_TEMPLATE=wovenessence_otp
WHATSAPP_OTP_INCLUDE_BUTTON=true
# Body variables in the approved OTP template: 1 = code only, 2 = code + purpose ("Login").
WHATSAPP_OTP_BODY_PARAMS=2
WHATSAPP_ORDER_CONFIRMATION_TEMPLATE=
WHATSAPP_ORDER_SHIPPED_TEMPLATE=
WHATSAPP_ORDER_DELIVERED_TEMPLATE=
# Optional single-variable Utility template for Admin → WhatsApp → Send test.
WHATSAPP_TEST_TEMPLATE=

# Optional tuning (defaults shown).
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Must match the code-expiration footer of the approved authentication template
# (the approved wovenessence_otp template says "Expires in 1 minute").
WHATSAPP_OTP_TTL_MINUTES=1
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_OTP_MAX_PER_HOUR=5
WHATSAPP_MAX_ATTEMPTS=3
WHATSAPP_REQUEST_TIMEOUT_MS=8000
WHATSAPP_TRACKING_TOKEN_DAYS=90

# Protects /api/v1/cron/whatsapp (queued notification retries). Use a long random value.
CRON_SECRET=

# Optional; payments run in stub mode when blank.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard → Account & Settings → Webhooks → Secret. Verifies the raw body of
# POST /api/v1/payments/razorpay/webhook (X-Razorpay-Signature). Blank = the webhook answers 400.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Shiprocket (server-only). Adds POST /api/v1/admin/orders/:orderNo/ship and
# POST /api/v1/shipping/webhook. Shipping stays off until email + password are set.
# ---------------------------------------------------------------------------
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname configured in Shiprocket → Settings → Pickup Addresses.
SHIPROCKET_PICKUP_LOCATION=
# Optional channel id for the Shiprocket sales channel; blank uses the account default.
SHIPROCKET_CHANNEL_ID=
# Token you enter in Shiprocket → Settings → Webhooks (sent back as a header on delivery events).
SHIPROCKET_WEBHOOK_TOKEN=
# Optional API host override. Default: https://apiv2.shiprocket.in
SHIPROCKET_BASE_URL=
# Optional shipment defaults (grams/rupees/counts handled by the lib).
SHIPROCKET_WEIGHT_KG=
SHIPROCKET_BOX_LENGTH_CM=
SHIPROCKET_BOX_BREADTH_CM=
SHIPROCKET_BOX_HEIGHT_CM=
# Email used when a website order has no customer email on file.
SHIPROCKET_FALLBACK_EMAIL=
